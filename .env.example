# ==========================================
# KINETIC PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# 1. FRONTEND CONFIGURATION
VITE_API_URL="http://localhost:5000/api"

# 2. BACKEND SERVER CONFIGURATION
PORT=5000
JWT_SECRET="kinetic_jwt_super_secret_key_change_me_in_production_2026"

# 3. MONGODB DATABASE CONFIGURATION
# Default: Local MongoDB instance.
# For Cloud Production: Replace with MongoDB Atlas Connection String e.g.:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/kinetic?retryWrites=true&w=majority"
MONGODB_URI="mongodb://127.0.0.1:27017/kinetic"

# 4. CLOUDINARY MEDIA STORAGE CONFIGURATION
# Sign up free at https://cloudinary.com to obtain these credentials.
CLOUDINARY_CLOUD_NAME="kinetic-demo"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_cloudinary_api_secret_key"

# 5. LIVE MEDIA PROVIDERS
JAMENDO_CLIENT_ID="your_jamendo_client_id"
JAMENDO_CLIENT_SECRET="your_jamendo_client_secret"
PEXELS_API_KEY="your_pexels_api_key"
