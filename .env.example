# Frontend (Vercel). Only VITE_API_URL belongs here: anything named VITE_* is published in the app bundle.
# Must end with /api, for example https://your-backend.onrender.com/api
VITE_API_URL=

# ---- Local development only: values for the combined dev server (npm run dev:all). ----
# Never commit real values. In production these live on Render, not in the frontend project.
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JAMENDO_CLIENT_ID=
PEXELS_API_KEY=
